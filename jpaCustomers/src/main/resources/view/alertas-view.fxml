<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.neomonitor.jpa.controller.AlertasController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Historial de Alertas" />

    <TableView fx:id="alertasTable" prefHeight="300.0" prefWidth="500.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha y Hora" />
            <TableColumn fx:id="colGravedad" prefWidth="100.0" text="Gravedad" />
            <TableColumn fx:id="colDescripcion" prefWidth="250.0" text="Descripción" />
        </columns>
    </TableView>

    <Button onAction="#closeWindow" text="Cerrar Panel" />
</VBox>
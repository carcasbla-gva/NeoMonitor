<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.neomonitor.jpa.controller.ServerFormController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Añadir Nuevo Servidor" />

    <TextField fx:id="ipField" promptText="Dirección IP (Ej: 192.168.1.100)" />
    <TextField fx:id="osField" promptText="Sistema Operativo (Ej: Ubuntu 22.04)" />

    <ComboBox fx:id="statusCombo" promptText="Estado del servidor" prefWidth="300.0" />

    <TextField fx:id="adminIdField" promptText="ID del Administrador (Ej: 1)" />

    <HBox alignment="CENTER" spacing="15.0">
        <Button onAction="#handleSave" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Guardar" />
        <Button onAction="#handleCancel" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Cancelar" />
    </HBox>
</VBox>